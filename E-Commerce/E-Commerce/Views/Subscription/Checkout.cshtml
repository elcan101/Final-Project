@{
    ViewData["Title"] = "Ödəniş";
    var planType = (E_Commerce.Models.SubscriptionPlanType)ViewBag.PlanType;
    var price = (decimal)ViewBag.Price;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">💳 Ödəniş</h4>
    <a asp-action="Index" class="text-muted">← Geri</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<p class="text-center text-muted small mb-4">
    Bu, <b>test rejimində saxta ödəniş sistemidir</b> — real kart məlumatı saxlanılmır və pul tutulmur.
</p>

<div class="fake-card-preview" id="cardPreview">
    <div class="d-flex justify-content-between align-items-center">
        <span>💳 OKEAN PASS</span>
        <span id="previewBrand">VISA</span>
    </div>
    <div class="fake-card-number" id="previewNumber">•••• •••• •••• ••••</div>
    <div class="fake-card-row">
        <span id="previewHolder">AD SOYAD</span>
        <span id="previewExpiry">AA/İİ</span>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="form-card">
            <h6 class="section-title">@planType planı — @price AZN / ay</h6>

            <form asp-action="Subscribe" method="post">
                <input type="hidden" name="planType" value="@planType" />

                <div class="mb-3">
                    <label class="form-label">Kart üzərindəki ad</label>
                    <input name="cardHolder" id="cardHolder" class="form-control" placeholder="AD SOYAD" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Kart nömrəsi</label>
                    <input name="cardNumber" id="cardNumber" class="form-control" placeholder="4242 4242 4242 4242" maxlength="19" required />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label class="form-label">Son istifadə tarixi</label>
                        <input name="expiry" id="expiry" class="form-control" placeholder="AA/İİ" maxlength="5" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">CVC</label>
                        <input name="cvc" id="cvc" class="form-control" placeholder="123" maxlength="4" required />
                    </div>
                </div>

                <button type="submit" class="btn-deal w-100">@price AZN ödə</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const numberInput = document.getElementById('cardNumber');
        const holderInput = document.getElementById('cardHolder');
        const expiryInput = document.getElementById('expiry');
        const previewNumber = document.getElementById('previewNumber');
        const previewHolder = document.getElementById('previewHolder');
        const previewExpiry = document.getElementById('previewExpiry');
        const previewBrand = document.getElementById('previewBrand');

        numberInput.addEventListener('input', () => {
            let digits = numberInput.value.replace(/\D/g, '').slice(0, 16);
            numberInput.value = digits.replace(/(.{4})/g, '$1 ').trim();
            previewNumber.textContent = digits.length ? numberInput.value.padEnd(19, '•') : '•••• •••• •••• ••••';
            previewBrand.textContent = digits.startsWith('4') ? 'VISA' : digits.startsWith('5') ? 'MASTERCARD' : 'KART';
        });

        holderInput.addEventListener('input', () => {
            previewHolder.textContent = holderInput.value.toUpperCase() || 'AD SOYAD';
        });

        expiryInput.addEventListener('input', () => {
            let digits = expiryInput.value.replace(/\D/g, '').slice(0, 4);
            if (digits.length >= 3) digits = digits.slice(0, 2) + '/' + digits.slice(2);
            expiryInput.value = digits;
            previewExpiry.textContent = digits || 'AA/İİ';
        });
    </script>
}
