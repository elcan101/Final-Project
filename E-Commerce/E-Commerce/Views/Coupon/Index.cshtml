@model IEnumerable<E_Commerce.Models.Coupon>

@{
    ViewData["Title"] = "Kuponlar";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Endirim Kuponları</h4>
    <a asp-action="Create" class="btn-deal">+ Yeni Kupon</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model != null && Model.Any())
{
    <div class="simple-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Endirim</th>
                    <th>Vəziyyət</th>
                    <th class="text-end">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coupon in Model)
                {
                    <tr>
                        <td class="fw-bold">@coupon.Code</td>
                        <td>@coupon.DiscountAmount AZN</td>
                        <td>
                            <form asp-action="ToggleStatus" asp-route-id="@coupon.Id" method="post" class="d-inline">
                                @if (coupon.IsActive)
                                {
                                    <button type="submit" class="status-badge" style="border:none;cursor:pointer;">Aktiv</button>
                                }
                                else
                                {
                                    <button type="submit" class="status-badge" style="border:none;cursor:pointer;background:#fdeaea;color:#e63946;">Deaktiv</button>
                                }
                            </form>
                        </td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@coupon.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kuponu silmək istədiyinizə əminsiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted text-center py-5">Hələ heç bir kupon yoxdur.</p>
}
