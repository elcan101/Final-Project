@model IEnumerable<E_Commerce.Models.Coupon>

@{
    ViewData["Title"] = "Kuponlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Endirim Kuponları</h4>
    <a asp-action="Create" class="btn-deal">+ Yeni Kupon</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="simple-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Endirim</th>
                    <th>Vəziyyət</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coupon in Model)
                {
                    <tr>
                        <td class="fw-bold">@coupon.Code</td>
                        <td>@coupon.DiscountAmount AZN</td>
                        <td>
                            @if (coupon.IsActive)
                            {
                                <span class="status-badge">Aktiv</span>
                            }
                            else
                            {
                                <span class="status-badge" style="background:#fdeaea;color:#e63946;">Deaktiv</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted text-center py-5">Hələ heç bir kupon yoxdur.</p>
}
