@model E_Commerce.Models.Coupon

@{
    ViewData["Title"] = "Yeni Kupon";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Yeni Kupon</h4>
    <a asp-action="Index" class="text-muted">← Siyahıya qayıt</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <form asp-action="Create" class="form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label">Kupon kodu</label>
                <input asp-for="Code" class="form-control" placeholder="Məs: OKEAN20" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DiscountAmount" class="form-label">Endirim məbləği (AZN)</label>
                <input asp-for="DiscountAmount" class="form-control" placeholder="0.00" />
                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
            </div>

            <div class="form-check form-switch type-switch mb-4">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Aktivdir</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                <button type="submit" class="btn-deal">Əlavə Et</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
