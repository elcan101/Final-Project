@model E_Commerce.Models.Category

@{
    ViewData["Title"] = "Yeni Kateqoriya";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Yeni Kateqoriya</h4>
    <a asp-action="Index" class="text-muted">← Siyahıya qayıt</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <form asp-action="Create" class="form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Kateqoriyanın adı</label>
                <input asp-for="Name" class="form-control" placeholder="Məs: Bədii Ədəbiyyat" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                <button type="submit" class="btn-deal">Əlavə Et</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
