@model IEnumerable<E_Commerce.Models.Category>

@{
    ViewData["Title"] = "Kateqoriyalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Kateqoriyalar</h4>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Category" asp-action="Create" class="btn-deal">+ Yeni Kateqoriya</a>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var category in Model)
        {
            <div class="col-md-4">
                <a asp-controller="Category" asp-action="Products" asp-route-id="@category.Id" class="text-decoration-none category-card-link">
                    <div class="product-card text-start">
                        <h6 class="mb-1">@category.Name</h6>
                        <small class="text-muted">@category.Products.Count(p => !p.IsDeleted) kitab</small>
                    </div>
                </a>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted text-center py-5">Hələ heç bir kateqoriya yoxdur.</p>
}
