@model E_Commerce.Models.Cart

@{
    ViewData["Title"] = "Səbətim";
    var items = (Model.CartItems ?? new List<E_Commerce.Models.CartItem>())
        .Where(ci => ci.Product != null)
        .ToList();
    decimal total = items.Sum(ci => ci.Product.Price * ci.Quantity);

    var appliedCode = Context.Session.GetString("AppliedCouponCode");
    var appliedDiscountStr = Context.Session.GetString("AppliedCouponDiscount");
    decimal appliedDiscount = 0;
    if (!string.IsNullOrEmpty(appliedDiscountStr))
        decimal.TryParse(appliedDiscountStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out appliedDiscount);
}

<h4 class="mb-4">Səbətim</h4>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (items.Any())
{
    <div class="cart-list">
        @foreach (var item in items)
        {
            <div class="cart-row d-flex align-items-center justify-content-between flex-wrap gap-3" id="cart-row-@item.Id">
                <div class="d-flex align-items-center gap-3">
                    <img src="@item.Product.ImageUrl" alt="@item.Product.Title" class="cart-thumb" />
                    <div>
                        <div class="fw-bold">@item.Product.Title</div>
                        <small class="text-muted">@item.Product.Price AZN / ədəd</small>
                    </div>
                </div>

                <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-2 qty-form" data-id="@item.Id">
                    <input type="hidden" name="id" value="@item.Id" />
                    <input type="number" name="quantity" value="@item.Quantity" min="0"
                           class="form-control form-control-sm qty-input"
                           data-price="@item.Product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           data-id="@item.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary d-none">Yenilə</button>
                    <span class="qty-saving text-muted small d-none">yadda saxlanır...</span>
                </form>

                <div class="fw-bold" id="line-total-@item.Id" style="min-width: 90px; text-align:right;">@((item.Product.Price * item.Quantity)) AZN</div>

                <a asp-action="Remove" asp-route-id="@item.Id" class="text-danger" title="Sil">✕</a>
            </div>
        }
    </div>

    <div class="checkout-box mt-4">
        <form asp-action="ApplyCoupon" method="post" class="d-flex gap-2 flex-wrap">
            <input type="text" name="code" class="form-control" placeholder="Promokodunuz varsa daxil edin" style="width:220px" />
            <button type="submit" class="btn btn-outline-dark">Tətbiq et</button>
        </form>

        <div class="checkout-summary">
            @if (!string.IsNullOrEmpty(appliedCode))
            {
                <div class="text-success small mb-1">✅ "@appliedCode" tətbiq olundu: -@appliedDiscount AZN</div>
                <h5 class="mb-0">Yekun: <span id="grand-total">@Math.Max(0, total - appliedDiscount)</span> AZN</h5>
            }
            else
            {
                <h5 class="mb-0">Yekun: <span id="grand-total">@total</span> AZN</h5>
            }
            <a asp-controller="Order" asp-action="ChooseLocation" class="btn-deal mt-2 d-inline-block">Sifarişi tamamla</a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">Səbətiniz boşdur.</p>
        <a asp-controller="Product" asp-action="Index" class="btn-deal">Kitablara bax</a>
    </div>
}

@section Scripts {
    <script>
       
        (function () {
            var discount = @Html.Raw(appliedDiscount.ToString(System.Globalization.CultureInfo.InvariantCulture));
            var saveTimers = {};

            function formatAmount(n) {
                return Math.round(n * 100) / 100;
            }

            function recalcAll() {
                var grandTotal = 0;
                document.querySelectorAll('.qty-input').forEach(function (input) {
                    var price = parseFloat(input.getAttribute('data-price')) || 0;
                    var qty = Math.max(0, parseInt(input.value, 10) || 0);
                    var lineTotal = price * qty;
                    grandTotal += lineTotal;

                    var lineEl = document.getElementById('line-total-' + input.getAttribute('data-id'));
                    if (lineEl) lineEl.textContent = formatAmount(lineTotal) + ' AZN';
                });

                var grandEl = document.getElementById('grand-total');
                if (grandEl) grandEl.textContent = formatAmount(Math.max(0, grandTotal - discount));
            }

            function scheduleSave(form, id) {
                clearTimeout(saveTimers[id]);
                var savingLabel = form.querySelector('.qty-saving');
                if (savingLabel) savingLabel.classList.remove('d-none');

                saveTimers[id] = setTimeout(function () {
                    fetch(form.action, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams(new FormData(form)).toString()
                    })
                        .then(function () {
                            if (savingLabel) savingLabel.classList.add('d-none');
                            var input = form.querySelector('.qty-input');
                            if (input && parseInt(input.value, 10) <= 0) {
                                window.location.reload();
                            }
                        })
                        .catch(function () {
                            if (savingLabel) savingLabel.classList.add('d-none');
                        });
                }, 600);
            }

            document.querySelectorAll('.qty-input').forEach(function (input) {
                input.addEventListener('input', function () {
                    recalcAll();
                    scheduleSave(input.closest('form'), input.getAttribute('data-id'));
                });
            });
        })();
    </script>
}
