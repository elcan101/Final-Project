@model IEnumerable<E_Commerce.Models.Product>

@{
    ViewData["Title"] = "Ana Səhifə";
}

<!-- hero banner -->
<div class="hero mb-5">
    <div class="hero-left">
        <div class="tagline">TƏLƏBƏLƏRƏ ÖZƏL</div>
        <h1>XÜSUSİ <span>ENDİRİMLƏR</span></h1>
        <p class="text-muted">Bütün tələbələr üçün sərfəli qiymətlər</p>
        <a href="/Product" class="btn-deal">ENDİRİMDƏN YARARLAN</a>
    </div>

    <div class="hero-right">
        <div class="promo-slider" id="promoSlider">
            <div class="promo-track" id="promoTrack">

                <div class="promo-slide slide-summer">
                    <div class="promo-content">
                        <span class="promo-tag">YAY TƏTİLİ</span>
                        <h3>Okean Kitabevi ilə<br>daha əyləncəli!</h3>
                        <p>Yay oxu siyahını bizimlə tamamla</p>
                        <a href="/Product" class="promo-btn">Kəşf et</a>
                    </div>
                    <div class="promo-art">
                        <span class="art-emoji e1">☀️</span>
                        <span class="art-emoji e2">📚</span>
                        <span class="art-emoji e3">🏖️</span>
                        <span class="art-emoji e4">🌊</span>
                    </div>
                </div>

                <div class="promo-slide slide-student">
                    <div class="promo-content">
                        <span class="promo-tag">TƏLƏBƏLƏRƏ ÖZƏL</span>
                        <h3>Xüsusi<br>Endirimlər</h3>
                        <p>Tələbə kartınla əlavə endirim qazan</p>
                        <a href="/Product" class="promo-btn">Endirimə bax</a>
                    </div>
                    <div class="promo-art">
                        <span class="art-emoji e1">🎓</span>
                        <span class="art-emoji e2">📘</span>
                        <span class="art-emoji e3">✏️</span>
                        <span class="art-emoji e4">🎒</span>
                    </div>
                </div>

                <div class="promo-slide slide-kids">
                    <div class="promo-content">
                        <span class="promo-tag">KİÇİKLƏR ÜÇÜN</span>
                        <h3>Uşaq Ədəbiyyatı<br>Dünyası</h3>
                        <p>Rəngarəng hekayələr, sonsuz macəra</p>
                        <a href="/Product" class="promo-btn">Kitablara bax</a>
                    </div>
                    <div class="promo-art">
                        <span class="art-emoji e1">🧸</span>
                        <span class="art-emoji e2">🌈</span>
                        <span class="art-emoji e3">🎈</span>
                        <span class="art-emoji e4">📗</span>
                    </div>
                </div>

                <div class="promo-slide slide-secondhand">
                    <div class="promo-content">
                        <span class="promo-tag">İKİNCİ ƏL BAZAR</span>
                        <h3>Ucuz Qiymətə<br>Sevimli Kitablar</h3>
                        <p>Al, sat, dəyişdir — hamısı bir yerdə</p>
                        <a href="/Product" class="promo-btn">Bazara bax</a>
                    </div>
                    <div class="promo-art">
                        <span class="art-emoji e1">🔄</span>
                        <span class="art-emoji e2">📕</span>
                        <span class="art-emoji e3">💰</span>
                        <span class="art-emoji e4">🤝</span>
                    </div>
                </div>

            </div>

            <button class="promo-arrow prev" id="promoPrev" aria-label="Əvvəlki">‹</button>
            <button class="promo-arrow next" id="promoNext" aria-label="Növbəti">›</button>

            <div class="promo-dots" id="promoDots">
                <span class="dot active" data-i="0"></span>
                <span class="dot" data-i="1"></span>
                <span class="dot" data-i="2"></span>
                <span class="dot" data-i="3"></span>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var track = document.getElementById('promoTrack');
        var slider = document.getElementById('promoSlider');
        var dots = document.querySelectorAll('#promoDots .dot');
        var slidesCount = dots.length;
        var current = 0;
        var timer;

        function goTo(i) {
            current = (i + slidesCount) % slidesCount;
            track.style.transform = 'translateX(-' + (current * 100) + '%)';
            dots.forEach(function (d, idx) {
                d.classList.toggle('active', idx === current);
            });
        }

        function next() { goTo(current + 1); }
        function prev() { goTo(current - 1); }

        function startAuto() {
            timer = setInterval(next, 3800);
        }
        function stopAuto() {
            clearInterval(timer);
        }

        document.getElementById('promoNext').addEventListener('click', function () { next(); stopAuto(); startAuto(); });
        document.getElementById('promoPrev').addEventListener('click', function () { prev(); stopAuto(); startAuto(); });
        dots.forEach(function (d) {
            d.addEventListener('click', function () { goTo(parseInt(d.getAttribute('data-i'), 10)); stopAuto(); startAuto(); });
        });

        slider.addEventListener('mouseenter', stopAuto);
        slider.addEventListener('mouseleave', startAuto);

        startAuto();
    })();
</script>

<!-- xüsusiyyət ikonları -->
<div class="row mb-5">
    <div class="col-6 col-md-3 feature-box">
        <div class="emoji">🚚</div>
        <h6>Sürətli Çatdırılma</h6>
        <small class="text-muted">Sifariş 2-3 gün ərzində çatdırılır</small>
    </div>
    <div class="col-6 col-md-3 feature-box">
        <div class="emoji">💳</div>
        <h6>Rahat Ödəniş</h6>
        <small class="text-muted">Kart və ya nağd ödəniş</small>
    </div>
    <div class="col-6 col-md-3 feature-box">
        <div class="emoji">🏷️</div>
        <h6>Ən Sərfəli Təklif</h6>
        <small class="text-muted">Ən sərfəli qiymətlər</small>
    </div>
    <div class="col-6 col-md-3 feature-box">
        <div class="emoji">🔒</div>
        <h6>Təhlükəsiz Ödəniş</h6>
        <small class="text-muted">100% təhlükəsiz ödəniş</small>
    </div>
</div>

<!-- bestsellers -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Ən Çox Satılanlar</h4>
    <a href="/Product">Hamısına bax</a>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model.Take(6))
        {
            <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="product-card">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                        <img src="@item.ImageUrl" alt="@item.Title" />
                        <h6>@item.Title</h6>
                        <div class="author">@item.Category?.Name</div>
                        <div class="price">@item.Price AZN</div>
                    </a>
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="add-cart-btn">🛒 Səbətə əlavə et</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted text-center">Hazırda məhsul yoxdur.</p>
    }
</div>
