@model IEnumerable<E_Commerce.Models.Order>

@{
    ViewData["Title"] = "Sifarişlərim";
}

<h4 class="mb-4">Sifarişlərim</h4>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model != null && Model.Any())
{
    <div class="simple-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Sifariş №</th>
                    <th>Tarix</th>
                    <th>Məbləğ</th>
                    <th>Endirim</th>
                    <th>Keşbek</th>
                    <th>Vəziyyət</th>
                    <th>Kuryer</th>
                    <th>Kuryer əlaqə</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@order.TotalAmount AZN</td>
                        <td>@(order.DiscountAmount > 0 ? $"-{order.DiscountAmount} AZN" : "—")</td>
                        <td>@order.CashbackAmount AZN</td>
                        <td><span class="status-badge">@order.Status</span></td>
                        <td>
                            @if (order.IsPostDelivery)
                            {
                                <span>📮 Poçt — @order.District (@order.PostalCode)</span>
                                <div class="small text-muted mt-1">İzləmə kodu: <b>@order.TrackingCode</b></div>
                            }
                            else
                            {
                                @(order.Courier?.FullName ?? "—")
                            }
                        </td>
                        <td>
                            @if (!order.IsPostDelivery && order.Courier != null && !string.IsNullOrWhiteSpace(order.Courier.PhoneNumber))
                            {
                                <a href="tel:@order.Courier.PhoneNumber">@order.Courier.PhoneNumber</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="d-flex gap-2">
                            @if (!order.IsPostDelivery)
                            {
                                <a asp-action="Track" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">📍 İzlə</a>
                                @if (order.Status == "Hazırlanır")
                                {
                                    <form asp-action="MarkReady" asp-route-id="@order.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Hazırdır elan et</button>
                                    </form>
                                }
                            }
                            @if (order.Status != "Hazırlanır" && order.Status != "Ləğv edildi")
                            {
                                <a asp-action="Receipt" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">🧾 Qəbz</a>
                            }
                            @if (!order.IsPostDelivery && order.CourierProfileId == null
                                && (order.Status == "Hazırlanır" || order.Status == "Hazırdır"))
                            {
                                <form asp-action="Cancel" asp-route-id="@order.Id" method="post"
                                      onsubmit="return confirm('Sifarişi ləğv etmək istədiyinizə əminsiniz? Ödədiyiniz məbləğ balansınıza geri qaytarılacaq.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Ləğv et</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">Hələ heç bir sifarişiniz yoxdur.</p>
        <a asp-controller="Product" asp-action="Index" class="btn-deal">Kitablara bax</a>
    </div>
}
