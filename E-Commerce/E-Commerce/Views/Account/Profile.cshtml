@using E_Commerce.Models
@{
    ViewData["Title"] = "Profilim";
    var user = ViewBag.User as AppUser;
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var courierProfile = ViewBag.CourierProfile as CourierProfile;
    var subscriptions = ViewBag.Subscriptions as List<UserSubscription> ?? new List<UserSubscription>();
    var activeSub = subscriptions.FirstOrDefault(s => s.IsActive && s.ExpiryDate > DateTime.Now);
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <h4 class="mb-0">👤 Profilim</h4>
    <a asp-controller="Account" asp-action="EditProfile" class="btn btn-outline-dark">✏️ Məlumatları redaktə et</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="form-card">
            <h6 class="section-title mb-3">Şəxsi məlumatlar</h6>
            <div class="row gy-3">
                <div class="col-sm-6">
                    <div class="text-muted small">Ad Soyad</div>
                    <div class="fw-bold">@user?.FullName</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">E-poçt</div>
                    <div class="fw-bold">@user?.Email</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">Əlaqə nömrəsi</div>
                    <div class="fw-bold">@(string.IsNullOrWhiteSpace(user?.PhoneNumber) ? "Qeyd edilməyib" : user.PhoneNumber)</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">Rol</div>
                    <div class="fw-bold">@(roles.Any() ? string.Join(", ", roles) : "Müştəri")</div>
                </div>
            </div>
        </div>

        @if (courierProfile != null)
        {
            <div class="form-card mt-4">
                <h6 class="section-title mb-3">🚴 Kuryer profili</h6>
                <div class="row gy-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Ad Soyad</div>
                        <div class="fw-bold">@courierProfile.FullName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Nəqliyyat növü</div>
                        <div class="fw-bold">@courierProfile.VehicleType</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Əlaqə nömrəsi</div>
                        <div class="fw-bold">@courierProfile.PhoneNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Status</div>
                        <div class="fw-bold">@(courierProfile.IsAvailable ? "Boşdadır" : "Məşğuldur")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Balans</div>
                        <div class="fw-bold">@courierProfile.CurrentBalance.ToString("0.00") AZN</div>
                    </div>
                </div>
                <a asp-controller="Courier" asp-action="Dashboard" class="btn btn-outline-dark mt-3">Kuryer panelinə keç</a>
            </div>
        }
    </div>

    <div class="col-lg-6">
        <div class="form-card">
            <h6 class="section-title mb-3">📚 Abunəliklərim</h6>

            @if (activeSub != null)
            {
                <div class="alert alert-info">
                    Aktiv planınız: <b>@activeSub.PlanType</b> — bitmə tarixi: @activeSub.ExpiryDate.ToString("dd.MM.yyyy")
                </div>
                <div class="d-flex gap-2 flex-wrap mb-3">
                    <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-dark">Planı dəyişdir</a>
                    <form asp-controller="Subscription" asp-action="Cancel" method="post" onsubmit="return confirm('Abunəliyi ləğv etmək istədiyinizə əminsiniz?');">
                        <button type="submit" class="btn btn-outline-danger">Abunəliyi ləğv et</button>
                    </form>
                </div>
            }
            else
            {
                <p class="text-muted">Hazırda aktiv abunəliyiniz yoxdur.</p>
                <a asp-controller="Subscription" asp-action="Index" class="btn-deal d-inline-block mb-3">Abunəlik planlarına bax</a>
            }

            @if (subscriptions.Any())
            {
                <h6 class="mt-3 mb-2 small text-muted">Tarixçə</h6>
                <div class="d-flex flex-column gap-2">
                    @foreach (var s in subscriptions)
                    {
                        <div class="d-flex justify-content-between align-items-center product-card">
                            <div>
                                <b>@s.PlanType</b>
                                <div class="text-muted small">@s.StartDate.ToString("dd.MM.yyyy") — @s.ExpiryDate.ToString("dd.MM.yyyy")</div>
                            </div>
                            <span class="status-badge">@(s.IsActive && s.ExpiryDate > DateTime.Now ? "Aktiv" : "Bitib")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
