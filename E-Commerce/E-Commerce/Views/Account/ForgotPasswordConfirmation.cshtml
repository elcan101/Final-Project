@{
    ViewData["Title"] = "Link göndərildi";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="form-card text-center">
            <div class="reset-check-icon">✅</div>
            <h4 class="mb-2">Yoxlayın, e-poçtunuza baxın</h4>
            <p class="text-muted mb-4">
                Əgər bu e-poçt ünvanı ilə hesab mövcuddursa, şifrənizi yeniləmək üçün link həmin ünvana göndərildi.
                Linkin müddəti məhduddur, ona görə tezliklə istifadə edin.
            </p>

            @if (ViewBag.DevResetLink != null)
            {
                <div class="dev-reset-box">
                    <div class="dev-reset-label">Test rejimi — real SMTP qoşulmayıb</div>
                    <p class="text-muted mb-2" style="font-size:13px;">Aşağıdakı link normalda yalnız e-poçt qutusuna gedərdi, sınaq üçün burada göstərilir:</p>
                    <a href="@ViewBag.DevResetLink" class="dev-reset-link">@ViewBag.DevResetLink</a>
                </div>
            }

            <a asp-action="Login" class="btn-deal w-100 mt-3">Girişə qayıt</a>
        </div>
    </div>
</div>
