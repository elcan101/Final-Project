@model E_Commerce.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifrəni unutmusunuz?";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="form-card">
            <h6 class="section-title">Şifrə bərpası</h6>
            <h4 class="mb-2">Şifrənizi unutmusunuz?</h4>
            <p class="text-muted mb-4">E-poçt ünvanınızı daxil edin, şifrənizi yeniləmək üçün link göndərək.</p>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="siz@example.com" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-deal w-100">Sıfırlama linki göndər</button>
            </form>

            <p class="text-center text-muted mt-4 mb-0">
                <a asp-action="Login">← Girişə qayıt</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
