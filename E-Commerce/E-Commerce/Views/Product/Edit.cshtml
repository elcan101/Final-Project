@model E_Commerce.Models.Product

@{
    ViewData["Title"] = "Kitabı Redaktə Et";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Kitabı Redaktə Et</h4>
    <a asp-action="Manage" class="text-muted">← Kitablarıma qayıt</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" class="form-card" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h6 class="section-title">Əsas məlumat</h6>
            <div class="row g-3 mb-2">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label">Kitabın adı</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label">Kateqoriya</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">— Seçin —</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Author" class="form-label">Müəllif</label>
                    <input asp-for="Author" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Publisher" class="form-label">Nəşriyyat</label>
                    <input asp-for="Publisher" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Language" class="form-label">Dil</label>
                    <input asp-for="Language" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PageCount" class="form-label">Səhifə sayı</label>
                    <input asp-for="PageCount" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Təsvir</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label">Qiymət (AZN)</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StockCount" class="form-label">Stok sayı</label>
                    <input asp-for="StockCount" class="form-control" />
                    <span asp-validation-for="StockCount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Rating" class="form-label">Reytinq</label>
                    <input asp-for="Rating" class="form-control" />
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>
            </div>

            <h6 class="section-title">Kitabın növü</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="form-check form-switch type-switch">
                        <input asp-for="IsDigital" class="form-check-input" role="switch" />
                        <label asp-for="IsDigital" class="form-check-label">E-Kitab</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch type-switch">
                        <input asp-for="IsAudio" class="form-check-input" role="switch" />
                        <label asp-for="IsAudio" class="form-check-label">Səsli kitab</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch type-switch">
                        <input asp-for="IsSecondHand" class="form-check-input" role="switch" />
                        <label asp-for="IsSecondHand" class="form-check-label">İkinci əl</label>
                    </div>
                </div>
            </div>

            <h6 class="section-title">Cild növü</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="form-check">
                        <input type="radio" name="IsHardcover" value="true" class="form-check-input" id="coverHard" checked="@Model.IsHardcover" />
                        <label class="form-check-label" for="coverHard">📕 Cildli</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <input type="radio" name="IsHardcover" value="false" class="form-check-input" id="coverSoft" checked="@(!Model.IsHardcover)" />
                        <label class="form-check-label" for="coverSoft">📗 Cildsiz</label>
                    </div>
                </div>
            </div>

            <h6 class="section-title">Media</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="ImageUrl" class="form-label">Şəkil linki</label>
                    <input asp-for="ImageUrl" class="form-control" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">PDF faylı</label>
                    <input type="hidden" id="removePdf" name="removePdf" value="false" />
                    <div id="pdfCurrentBlock" style="display:@(string.IsNullOrWhiteSpace(Model.PdfUrl) ? "none" : "block")">
                        <div class="form-control d-flex align-items-center justify-content-between">
                            <a href="@Model.PdfUrl" target="_blank">Cari fayl — bax</a>
                            <button type="button" id="pdfDeleteBtn" class="btn btn-sm btn-outline-danger ms-2">Sil</button>
                        </div>
                        <div class="form-text">Yeni fayl seçmək üçün əvvəlcə mövcud faylı silin</div>
                    </div>
                    <div id="pdfUploadBlock" style="display:@(string.IsNullOrWhiteSpace(Model.PdfUrl) ? "block" : "none")">
                        <input type="file" id="pdfFile" name="pdfFile" class="form-control" accept=".pdf" />
                        <div class="form-text">Yalnız e-kitab üçün — .pdf, maks. 100 MB</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Audio faylı</label>
                    <input type="hidden" id="removeAudio" name="removeAudio" value="false" />
                    <div id="audioCurrentBlock" style="display:@(string.IsNullOrWhiteSpace(Model.AudioUrl) ? "none" : "block")">
                        <div class="form-control d-flex align-items-center justify-content-between">
                            <a href="@Model.AudioUrl" target="_blank">Cari fayl — bax</a>
                            <button type="button" id="audioDeleteBtn" class="btn btn-sm btn-outline-danger ms-2">Sil</button>
                        </div>
                        <div class="form-text">Yeni fayl seçmək üçün əvvəlcə mövcud faylı silin</div>
                    </div>
                    <div id="audioUploadBlock" style="display:@(string.IsNullOrWhiteSpace(Model.AudioUrl) ? "block" : "none")">
                        <input type="file" id="audioFile" name="audioFile" class="form-control" accept=".mp3,.wav,.m4a,.ogg,.aac" />
                        <div class="form-text">Yalnız səsli kitab üçün — mp3/wav/m4a/ogg/aac, maks. 100 MB</div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Manage" class="btn btn-outline-secondary">Ləğv et</a>
                <button type="submit" class="btn-deal">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Fayl varkən yalnız "Sil" düyməsi göstərilir, yeni fayl seçmək üçün əvvəlcə
        // silinməlidir — silindikdən sonra fayl seçmə sahəsi görünür.
        function setupFileToggle(deleteBtnId, currentBlockId, uploadBlockId, removeFieldId) {
            var deleteBtn = document.getElementById(deleteBtnId);
            var currentBlock = document.getElementById(currentBlockId);
            var uploadBlock = document.getElementById(uploadBlockId);
            var removeField = document.getElementById(removeFieldId);
            if (!deleteBtn) return;
            deleteBtn.addEventListener('click', function () {
                removeField.value = 'true';
                currentBlock.style.display = 'none';
                uploadBlock.style.display = 'block';
            });
        }
        setupFileToggle('pdfDeleteBtn', 'pdfCurrentBlock', 'pdfUploadBlock', 'removePdf');
        setupFileToggle('audioDeleteBtn', 'audioCurrentBlock', 'audioUploadBlock', 'removeAudio');
    </script>
}
