@model E_Commerce.Models.Wallet

@{
    ViewData["Title"] = "Balansım";
}

<h4 class="mb-4">Balansım</h4>

<div class="row g-3">
    <div class="col-md-6">
        <div class="product-card text-start">
            <small class="text-muted">Cari Balans</small>
            <h3 class="mt-1" style="color:#0b2f6b;">@Model.Balance AZN</h3>
        </div>
    </div>
    <div class="col-md-6">
        <div class="product-card text-start">
            <small class="text-muted">Ümumi Qazanılan Keşbek</small>
            <h3 class="mt-1" style="color:#0b2f6b;">@Model.TotalCashbackEarned AZN</h3>
        </div>
    </div>
</div>
