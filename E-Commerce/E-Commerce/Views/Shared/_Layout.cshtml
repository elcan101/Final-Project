@using Microsoft.EntityFrameworkCore
@using E_Commerce.Data
@using System.Security.Claims
@inject AppDbContext DbContext
@{
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    Func<string, string> navActive = ctrl =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    decimal? headerWalletBalance = null;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var headerUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrEmpty(headerUserId))
        {
            var walletBalance = DbContext.Wallets
                .Where(w => w.UserId == headerUserId && !w.IsDeleted)
                .Select(w => (decimal?)w.Balance)
                .FirstOrDefault() ?? 0.00m;

            var courierBalance = DbContext.CourierProfiles
                .Where(c => c.CourierId == headerUserId && !c.IsDeleted)
                .Select(c => (decimal?)c.CurrentBalance)
                .FirstOrDefault() ?? 0.00m;

            headerWalletBalance = walletBalance + courierBalance;
        }
    }
}
