@{
    // hansı controller-dəyik - menyuda altını xətt çəkmək üçün
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    Func<string, string> navActive = ctrl =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Okean Kitabevi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/style.css" />
</head>
<body>

    <!-- üst sətir: loqo + axtarış + səbət/giriş -->
    <div class="top-bar">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <a class="logo" href="/">
                <svg class="logo-mark" width="30" height="30" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                    <rect width="60" height="60" rx="10" fill="#0b2f6b"/>
                    <path d="M30 20 L14 15 L14 34 L18 36 L30 40 L42 36 L46 34 L46 15 Z" fill="#ffffff"/>
                    <path d="M30 20 L30 40" stroke="#0b2f6b" stroke-width="1.5"/>
                    <path d="M14 34 L8 37" stroke="#4a90d9" stroke-width="3" stroke-linecap="round"/>
                    <path d="M14 30 L7 31.5" stroke="#4a90d9" stroke-width="3" stroke-linecap="round"/>
                    <path d="M46 34 L52 37" stroke="#4a90d9" stroke-width="3" stroke-linecap="round"/>
                    <path d="M46 30 L53 31.5" stroke="#4a90d9" stroke-width="3" stroke-linecap="round"/>
                </svg>
                <span class="logo-text">OKEAN <b>KİTABEVİ</b></span>
            </a>

            <form class="search-form d-none d-md-flex" action="/Product" method="get">
                <input type="text" name="q" class="form-control" placeholder="10 milyondan çox kitab adı arasında axtar" />
                <button type="submit">🔍</button>
            </form>

            <div class="d-flex align-items-center gap-2 auth-actions">
                <a href="/Cart" class="icon-link" title="Səbət">🛒</a>
                <a href="/Order" class="icon-link" title="Sifarişlərim">👤</a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="text-muted d-none d-md-inline me-1">Salam, @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn-nav btn-nav-outline">Çıxış</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-nav btn-nav-outline">Giriş</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-nav btn-nav-solid">Qeydiyyat</a>
                }
            </div>
        </div>
    </div>

    <!-- alt sətir: kateqoriya menyusu -->
    <nav class="navbar navbar-expand-lg category-bar">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link @navActive("Home")" href="/">Ana səhifə</a></li>
                    <li class="nav-item"><a class="nav-link @navActive("Product")" href="/Product">Kitablar</a></li>
                    <li class="nav-item"><a class="nav-link @navActive("Category")" href="/Category">Kateqoriyalar</a></li>
                    <li class="nav-item"><a class="nav-link @navActive("Listing")" href="/Listing">C2C Bazar</a></li>
                    <li class="nav-item"><a class="nav-link @navActive("Subscription")" href="/Subscription">Kitab Pass</a></li>
                    <li class="nav-item"><a class="nav-link @navActive("Rental")" href="/Rental">İcarələrim</a></li>
                    <li class="nav-item"><a class="nav-link @navActive("Courier")" href="/Courier/Dashboard">Kuryer Panel</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link sale @navActive("Coupon")" href="/Coupon">Kuponlar</a></li>
                        <li class="nav-item"><a class="nav-link @navActive("Admin")" href="/AdminPanel/Admin">🛠️ Admin Panel</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="site-footer mt-5">
        <div class="container">
            <div class="row gy-4 py-5">
                <div class="col-md-4">
                    <div class="logo-text mb-2" style="color:#fff;">OKEAN <b>KİTABEVİ</b></div>
                    <p class="text-light-50 small mb-0">Azərbaycanın virtual 3D kitab rəfi, C2C kitab bazarı və icarə platforması.</p>
                    <p class="text-light-50 small mt-2 mb-0">📅 2021-dən bu yana istifadə edilir</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white mb-3">Əlaqə</h6>
                    <ul class="list-unstyled footer-contact">
                        <li>📞 <a href="tel:+994514870146">+994 51 487 01 46</a></li>
                        <li>💬 <a href="https://wa.me/994514870146" target="_blank" rel="noopener">WhatsApp: +994 51 487 01 46</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white mb-3">Bizi izləyin</h6>
                    <div class="d-flex gap-3 footer-social">
                        <a href="https://instagram.com/okeankitabevi" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/><circle cx="17.6" cy="6.4" r="1.2" fill="currentColor"/></svg>
                        </a>
                        <a href="https://tiktok.com/okeankitabevi" target="_blank" rel="noopener" title="TikTok" aria-label="TikTok">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 3c.4 2.2 2 3.7 4.3 3.9V10c-1.5.1-2.9-.3-4.3-1.2v6.6c0 3.3-2.7 5.6-5.7 5.3-2.6-.2-4.6-2.4-4.6-5 0-2.9 2.5-5.3 5.5-5v3.3c-1.2-.3-2.4.5-2.5 1.8-.1 1.2.9 2.2 2.1 2.1 1-.1 1.8-.9 1.8-2V3h3.4Z" stroke="currentColor" stroke-width="0.6" fill="currentColor"/></svg>
                        </a>
                        <a href="https://wa.me/994514870146" target="_blank" rel="noopener" title="WhatsApp" aria-label="WhatsApp">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 8.8c.2-1 1.6-1 1.9-.3l.5 1.2c.2.4.1.9-.2 1.2l-.4.4c-.2.2-.2.5 0 .8.6 1 1.6 2 2.6 2.6.3.2.6.2.8 0l.4-.4c.3-.3.8-.4 1.2-.2l1.2.5c.7.3.7 1.7-.3 1.9-2.7.5-6.3-2.1-7.4-3.2C7.6 11.9 8 8.2 8.5 8.8Z" fill="currentColor"/></svg>
                        </a>
                    </div>
                    <p class="text-light-50 small mt-3 mb-0">Instagram &amp; TikTok: <b>okeankitabevi</b></p>
                </div>
            </div>
            <div class="footer-bottom text-center py-3">
                &copy; 2021 Okean Kitabevi — Bütün hüquqlar qorunur.
            </div>
        </div>
    </footer>

    <a href="https://wa.me/994514870146" target="_blank" rel="noopener" class="whatsapp-float" title="WhatsApp ilə yazın" aria-label="WhatsApp ilə yazın">💬</a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/jsscript.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
