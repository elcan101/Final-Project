    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <form id="notifAntiForgeryForm">@Html.AntiForgeryToken()</form>
        <script>
            (function () {
                const bellBtn = document.getElementById('notifBellBtn');
                const dropdown = document.getElementById('notifDropdown');
                const list = document.getElementById('notifList');
                const badge = document.getElementById('notifUnreadBadge');
                const markAllBtn = document.getElementById('notifMarkAllReadBtn');
                if (!bellBtn) return;

                function getToken() {
                    const tokenInput = document.querySelector('#notifAntiForgeryForm input[name="__RequestVerificationToken"]');
                    return tokenInput ? tokenInput.value : '';
                }

                function render(data) {
                    if (data.unreadCount > 0) {
                        badge.style.display = 'inline-flex';
                        badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;
                    } else {
                        badge.style.display = 'none';
                    }

                    if (!data.items || data.items.length === 0) {
                        list.innerHTML = '<div class="notif-empty"><span class="notif-empty-icon">🔔</span>Hələ bildiriş yoxdur.</div>';
                        return;
                    }

                    list.innerHTML = data.items.map(n => `
                        <a href="${n.url || '#'}" class="notif-item ${n.isRead ? '' : 'unread'}">
                            <div class="notif-item-title">${n.title}</div>
                            <div class="notif-item-msg">${n.message}</div>
                            <div class="notif-item-date">${n.createdDate}</div>
                        </a>
                    `).join('');
                }

                function loadRecent() {
                    fetch('/Notification/Recent')
                        .then(r => r.json())
                        .then(render)
                        .catch(() => {});
                }

                bellBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = dropdown.style.display === 'block';
                    dropdown.style.display = isOpen ? 'none' : 'block';
                    if (!isOpen) loadRecent();
                });

                document.addEventListener('click', (e) => {
                    if (!dropdown.contains(e.target) && e.target !== bellBtn) {
                        dropdown.style.display = 'none';
                    }
                });

                markAllBtn?.addEventListener('click', (e) => {
                    e.preventDefault();
                    fetch('/Notification/MarkAllRead', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': getToken() }
                    }).then(() => loadRecent());
                });

                loadRecent();
                setInterval(loadRecent, 30000); // 30 saniyədə bir yenilə
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

