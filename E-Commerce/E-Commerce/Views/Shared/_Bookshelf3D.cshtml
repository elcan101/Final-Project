@using System.Text.Json
@model IEnumerable<E_Commerce.Models.Product>

@{
    var shelfBooks = (Model ?? Enumerable.Empty<E_Commerce.Models.Product>())
        .Where(p => !string.IsNullOrEmpty(p.ImageUrl))
        .Take(10)
        .Select(p => new { id = p.Id, title = p.Title, imageUrl = p.ImageUrl, price = p.Price })
        .ToList();

    var shelfJson = JsonSerializer.Serialize(shelfBooks).Replace("</", "<\\/");
}

<section class="shelf3d-section mb-5" data-aos="fade-up">
    <div class="d-flex justify-content-between align-items-end mb-2 flex-wrap">
        <div>
            <div class="shelf3d-eyebrow">🪄 İMMERSİVE 3D TƏCRÜBƏ</div>
            <h4 class="mb-0">Virtual Kitab Rəfi</h4>
        </div>
        <div class="shelf3d-hint" id="shelf3dHint">Bir kitabı seçin →</div>
    </div>

    <div class="shelf3d-wrap">
        <div id="bookshelf3d-container" class="shelf3d-container">
            <div class="shelf3d-loading">
                <div class="shelf3d-spinner"></div>
                <span>Rəf yüklənir...</span>
            </div>
        </div>
    </div>
    <p class="shelf3d-caption text-muted">Siçanla sürüşdürüb rəfə baxın, kitabın üzərinə gələndə qabağa çıxır, klikləyəndə rəfdən götürülüb səhifəsinə keçirsiniz.</p>
</section>

<script id="bookshelf3d-data" type="application/json">@Html.Raw(shelfJson)</script>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
  }
}
</script>
<script type="module">
    // 3D rəf yüklənmirsə (internet/CDN/WebGL problemi) 6 saniyə sonra
    // sadə şəkil-şəbəkəsinə keçirik ki, "Rəf yüklənir..." əbədi qalmasın.
    const container = document.getElementById('bookshelf3d-container');
    let settled = false;

    function showFallbackGrid() {
        if (settled || !container) return;
        settled = true;
        let books = [];
        try {
            books = JSON.parse(document.getElementById('bookshelf3d-data')?.textContent || '[]');
        } catch (e) { /* boş qalsın */ }

        if (!books.length) {
            container.innerHTML = '<div class="shelf3d-loading"><span>Hazırda göstəriləcək kitab yoxdur.</span></div>';
            return;
        }

        const cards = books.map(b => `
            <a href="/Product/Details/${b.id}" class="shelf3d-fallback-card">
                <img src="${b.imageUrl}" alt="${b.title}" loading="lazy" />
                <div class="shelf3d-fallback-title">${b.title}</div>
                <div class="shelf3d-fallback-price">${b.price} AZN</div>
            </a>`).join('');
        container.innerHTML = `<div class="shelf3d-fallback-grid">${cards}</div>`;
    }

    const fallbackTimer = setTimeout(showFallbackGrid, 6000);

    import('/js/bookshelf3d.js')
        .then(({ initBookshelf3D }) => {
            try {
                initBookshelf3D('bookshelf3d-container', 'bookshelf3d-data', () => {
                    settled = true;
                    clearTimeout(fallbackTimer);
                });
            } catch (err) {
                console.error('3D rəf başladıla bilmədi:', err);
                clearTimeout(fallbackTimer);
                showFallbackGrid();
            }
        })
        .catch((err) => {
            console.error('3D rəf modulu yüklənə bilmədi:', err);
            clearTimeout(fallbackTimer);
            showFallbackGrid();
        });
</script>
