@model IEnumerable<E_Commerce.Models.Product>

@{
    ViewData["Title"] = "Kitablarım";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">📚 Kitablarım</h4>
    <a asp-action="Create" class="btn-deal">+ Yeni Kitab</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model != null && Model.Any())
{
    <div class="simple-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Şəkil</th>
                    <th>Ad</th>
                    <th>Kateqoriya</th>
                    <th>Qiymət</th>
                    <th>Stok</th>
                    <th>Cild</th>
                    <th>Fayllar</th>
                    <th class="text-end">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="width:56px;">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Title" style="width:40px;height:56px;object-fit:cover;border-radius:4px;" />
                            }
                        </td>
                        <td class="fw-bold">@p.Title</td>
                        <td>@p.Category?.Name</td>
                        <td>@p.Price AZN</td>
                        <td>@p.StockCount</td>
                        <td>@(p.IsHardcover ? "Cildli" : "Cildsiz")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.PdfUrl))
                            {
                                <a href="@p.PdfUrl" target="_blank" class="badge bg-secondary text-decoration-none">PDF</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.AudioUrl))
                            {
                                <a href="@p.AudioUrl" target="_blank" class="badge bg-secondary text-decoration-none">🎧 Audio</a>
                            }
                            @if (string.IsNullOrWhiteSpace(p.PdfUrl) && string.IsNullOrWhiteSpace(p.AudioUrl))
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Redaktə</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kitabı silmək istədiyinizə əminsiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">Hələ heç bir kitab əlavə etməmisiniz.</p>
        <a asp-action="Create" class="btn-deal">İlk kitabınızı əlavə edin</a>
    </div>
}
