@model IEnumerable<E_Commerce.Models.Listing>
@{
    ViewData["Title"] = "C2C Bazar";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="mb-1">♻️ İkinci Əl Kitab Bazarı</h4>
        <p class="text-muted mb-0 small">Vətəndaşlar arası birbaşa alqı-satqı — Elan Ver → Alıcı Tap → Qazanc Əldə Et</p>
    </div>
    <a asp-action="Create" class="btn-deal">+ Elan Ver</a>
    <a asp-action="MyListings" class="btn btn-outline-dark">Mənim elanlarım</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<form method="get" class="d-flex gap-2 mb-4 flex-wrap">
    <input type="text" name="q" value="@Context.Request.Query["q"]" class="form-control" style="max-width:260px" placeholder="Ad və ya müəllif axtar" />
    <input type="number" name="minPrice" value="@Context.Request.Query["minPrice"]" class="form-control" style="max-width:130px" placeholder="Min AZN" />
    <input type="number" name="maxPrice" value="@Context.Request.Query["maxPrice"]" class="form-control" style="max-width:130px" placeholder="Max AZN" />
    <button type="submit" class="btn btn-outline-dark">Axtar</button>
</form>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var l in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="product-card">
                    @if (!string.IsNullOrEmpty(l.ImageUrl) && l.ImageUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="@l.ImageUrl" target="_blank" rel="noopener" class="d-flex flex-column align-items-center justify-content-center text-decoration-none" style="height:180px;background:#f1f4f9;border-radius:8px;color:#0b2f6b;">
                            <span style="font-size:2.5rem;">📄</span>
                            <span class="small">PDF sənədinə bax</span>
                        </a>
                    }
                    else
                    {
                        <img src="@(l.ImageUrl ?? "/images/no-cover.png")" alt="@l.Title" />
                    }
                    <h6>@l.Title</h6>
                    <div class="author">@(l.Author ?? l.Category?.Name)</div>
                    <div class="price">@l.Price AZN</div>
                    <form asp-action="Buy" asp-route-id="@l.Id" method="post">
                        <button type="submit" class="add-cart-btn">🤝 Al (Qazanc Əldə Et)</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted text-center">Hazırda aktiv elan yoxdur.</p>
    }
</div>
