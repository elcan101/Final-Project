@model E_Commerce.Models.Cart

@{
    ViewData["Title"] = "Səbətim";
    // silinmiş/olmayan məhsula bağlı "yetim" sətirləri kənara qoyuruq ki, səhifə çökməsin
    var items = (Model.CartItems ?? new List<E_Commerce.Models.CartItem>())
        .Where(ci => ci.Product != null)
        .ToList();
    decimal total = items.Sum(ci => ci.Product.Price * ci.Quantity);
}

<h4 class="mb-4">Səbətim</h4>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (items.Any())
{
    <div class="cart-list">
        @foreach (var item in items)
        {
            <div class="cart-row d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@item.Product.ImageUrl" alt="@item.Product.Title" class="cart-thumb" />
                    <div>
                        <div class="fw-bold">@item.Product.Title</div>
                        <small class="text-muted">@item.Product.Price AZN / ədəd</small>
                    </div>
                </div>

                <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="id" value="@item.Id" />
                    <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control form-control-sm qty-input" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Yenilə</button>
                </form>

                <div class="fw-bold" style="min-width: 90px; text-align:right;">@((item.Product.Price * item.Quantity)) AZN</div>

                <a asp-action="Remove" asp-route-id="@item.Id" class="text-danger" title="Sil">✕</a>
            </div>
        }
    </div>

    <div class="checkout-box mt-4">
        <form asp-action="ApplyCoupon" method="post" class="d-flex gap-2 flex-wrap">
            <input type="text" name="code" class="form-control" placeholder="Promokodunuz varsa daxil edin" style="width:220px" />
            <button type="submit" class="btn btn-outline-dark">Tətbiq et</button>
        </form>

        <div class="checkout-summary">
            @{
                var appliedCode = Context.Session.GetString("AppliedCouponCode");
                var appliedDiscountStr = Context.Session.GetString("AppliedCouponDiscount");
                decimal appliedDiscount = 0;
                if (!string.IsNullOrEmpty(appliedDiscountStr))
                    decimal.TryParse(appliedDiscountStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out appliedDiscount);
            }
            @if (!string.IsNullOrEmpty(appliedCode))
            {
                <div class="text-success small mb-1">✅ "@appliedCode" tətbiq olundu: -@appliedDiscount AZN</div>
                <h5 class="mb-0">Yekun: @Math.Max(0, total - appliedDiscount) AZN</h5>
            }
            else
            {
                <h5 class="mb-0">Yekun: @total AZN</h5>
            }
            <a asp-controller="Order" asp-action="ChooseLocation" class="btn-deal mt-2 d-inline-block">Sifarişi tamamla</a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">Səbətiniz boşdur.</p>
        <a asp-controller="Product" asp-action="Index" class="btn-deal">Kitablara bax</a>
    </div>
}
