@model E_Commerce.Models.Product
@{
    ViewData["Title"] = Model.Title;
    var reviews = ViewBag.Reviews as List<E_Commerce.Models.ProductReview> ?? new List<E_Commerce.Models.ProductReview>();
    bool hasEbookAccess = ViewBag.HasEbookAccess ?? false;
    bool hasAudioAccess = ViewBag.HasAudioAccess ?? false;
}

<div class="row g-5">
    <div class="col-md-4">
        <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm w-100" style="object-fit:cover; max-height:520px;" />
    </div>
    <div class="col-md-8">
        <div class="text-muted mb-1">@Model.Category?.Name</div>
        <h2 class="mb-1">@Model.Title</h2>
        <div class="text-muted small mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.Author))
            {
                <span>✍️ Müəllif: <b>@Model.Author</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Publisher))
            {
                <span class="ms-3">🏢 Nəşriyyat: <b>@Model.Publisher</b></span>
            }
        </div>

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <span class="status-badge">⭐ @Model.Rating.ToString("0.0")</span>
            @if (Model.IsSecondHand)
            {
                <span class="status-badge">♻️ İkinci əl</span>
            }
            @if (Model.IsDigital)
            {
                <span class="status-badge">📱 E-kitab</span>
            }
            @if (Model.IsAudio)
            {
                <span class="status-badge">🎧 Səsli kitab</span>
            }
        </div>

        <p class="text-muted">@Model.Description</p>

        @if (Model.IsAudio && !string.IsNullOrWhiteSpace(Model.AudioUrl))
        {
            <div class="form-card mb-3">
                @if (hasAudioAccess)
                {
                    <h6 class="mb-2">🎧 Səsli kitaba qulaq as</h6>
                    <audio controls preload="none" controlsList="nodownload" style="width:100%;">
                        <source src="@Model.AudioUrl" />
                        Brauzeriniz audio elementini dəstəkləmir.
                    </audio>
                }
                else
                {
                    <h6 class="mb-2">🎧 Səsli kitab mövcuddur</h6>
                    <p class="text-muted small mb-2">Bu kitabın səsli versiyasını dinləmək üçün <b>Premium</b> abunəlik tələb olunur.</p>
                    <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-dark px-4">Abunə ol</a>
                }
            </div>
        }

        @if (Model.IsDigital && !string.IsNullOrWhiteSpace(Model.PdfUrl))
        {
            <div class="form-card mb-3">
                @if (hasEbookAccess)
                {
                    <h6 class="mb-2">📄 E-kitabı oxu</h6>
                    <p class="text-muted small mb-2">Bu kitab yalnız saytda oxuna bilər — yükləmə mövcud deyil.</p>
                    <div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden;">
                        <iframe src="@Model.PdfUrl#toolbar=0&navpanes=0" style="width:100%; height:600px; border:none;" title="@Model.Title"></iframe>
                    </div>
                }
                else
                {
                    <h6 class="mb-2">📱 E-kitab mövcuddur</h6>
                    <p class="text-muted small mb-2">Bu kitabı saytda oxumaq üçün abunəlik planlarımızdan birinə qoşulun.</p>
                    <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-dark px-4">Abunə ol</a>
                }
            </div>
        }

        <div class="price mb-3" style="font-size:28px; font-weight:700; color:#0b2f6b;">@Model.Price AZN</div>

        <div class="d-flex gap-2 flex-wrap">
            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary px-4">🛒 Səbətə əlavə et</button>
            </form>
            <button type="button" class="btn btn-outline-dark px-4" id="featuresToggleBtn">📋 Xüsusiyyətlər</button>
            <a href="/Product" class="btn btn-outline-secondary px-4">← Kitablara qayıt</a>
        </div>

        <!-- Xüsusiyyətlər paneli: default gizli, düyməyə klikləndikdə açılır -->
        <div id="featuresPanel" class="mt-4" style="display:none;">
            <div class="form-card">
                <h6 class="mb-3">📋 Kitabın xüsusiyyətləri</h6>
                <div class="row gy-2 mb-3">
                    <div class="col-sm-6"><span class="text-muted">Kateqoriya:</span> <b>@(Model.Category?.Name ?? "—")</b></div>
                    <div class="col-sm-6"><span class="text-muted">Dil:</span> <b>@(Model.Language ?? "Qeyd edilməyib")</b></div>
                    <div class="col-sm-6"><span class="text-muted">Səhifə sayı:</span> <b>@(Model.PageCount.HasValue ? Model.PageCount.Value.ToString() : "Qeyd edilməyib")</b></div>
                    <div class="col-sm-6"><span class="text-muted">Cild:</span> <b>@(Model.IsHardcover ? "Cildli" : "Cildsiz")</b></div>
                </div>
                <h6 class="mb-2">Qısa məzmun</h6>
                <p class="text-muted mb-0">@Model.Description</p>
            </div>
        </div>

        <form asp-controller="Rental" asp-action="Rent" method="post" class="d-flex align-items-end gap-2 mt-3 flex-wrap">
            <input type="hidden" name="productId" value="@Model.Id" />
            <div>
                <label class="form-label small mb-1">İcarə müddəti (gün)</label>
                <input type="number" name="days" value="7" min="1" max="60" class="form-control" style="width:110px" />
            </div>
            <button type="submit" class="btn btn-outline-dark">📦 İcarəyə götür (0.20 AZN/gün)</button>
        </form>

        <div class="mt-3 text-muted small">
            Stokda: @(Model.StockCount > 0 ? $"{Model.StockCount} ədəd" : "Bitib")
        </div>
    </div>
</div>

<!-- Şərhlər bölməsi -->
<div class="row mt-5">
    <div class="col-lg-8">
        <h5 class="mb-3">💬 Müştəri şərhləri (@reviews.Count)</h5>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Product" asp-action="AddReview" method="post" class="form-card mb-4">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label small mb-1">Reytinqiniz</label>
                    <select name="rating" class="form-select" style="max-width:160px">
                        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                        <option value="4">⭐⭐⭐⭐ (4)</option>
                        <option value="3">⭐⭐⭐ (3)</option>
                        <option value="2">⭐⭐ (2)</option>
                        <option value="1">⭐ (1)</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Şərhiniz</label>
                    <textarea name="comment" class="form-control" rows="3" placeholder="Bu kitab haqqında fikrinizi yazın..." required></textarea>
                </div>
                <button type="submit" class="btn-deal">Şərh yaz</button>
            </form>
        }
        else
        {
            <p class="text-muted">Şərh yazmaq üçün <a asp-controller="Account" asp-action="Login">daxil olun</a>.</p>
        }

        @if (reviews.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var review in reviews)
                {
                    <div class="form-card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <b>@review.UserName</b>
                            <span class="status-badge">⭐ @review.Rating</span>
                        </div>
                        <div class="text-muted small mb-2">@review.CreatedDate.ToString("dd.MM.yyyy")</div>
                        <p class="mb-0">@review.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Hələ heç bir şərh yazılmayıb. İlk şərhi siz yazın!</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('featuresToggleBtn')?.addEventListener('click', function () {
            var panel = document.getElementById('featuresPanel');
            if (!panel) return;
            panel.style.display = (panel.style.display === 'none' || !panel.style.display) ? 'block' : 'none';
        });
    </script>
}
