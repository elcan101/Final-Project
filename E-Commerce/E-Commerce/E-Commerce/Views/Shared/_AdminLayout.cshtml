@{
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    Func<string, string> ahActive = ctrl =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/adminpanel/css/admin-horizon.css" />
</head>
<body>
    <div class="admin-horizon-wrap">

        <aside class="ah-sidebar">
            <a asp-area="AdminPanel" asp-controller="Admin" asp-action="Index" class="ah-sidebar-logo">
                🌊 OKEAN <span>ADMIN</span>
            </a>

            <ul class="ah-nav">
                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Index" class="@ahActive("Admin")"><span class="ah-nav-icon">📊</span> Dashboard</a></li>
                <li><a asp-area="" asp-controller="Product" asp-action="Manage" class="@ahActive("Product")"><span class="ah-nav-icon">📚</span> Kitablar</a></li>
                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Categories" class="@ahActive("Admin")"><span class="ah-nav-icon">🏷️</span> Kateqoriyalar</a></li>
                <li><a asp-area="" asp-controller="Coupon" asp-action="Index" class="@ahActive("Coupon")"><span class="ah-nav-icon">🎟️</span> Kuponlar</a></li>
                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Orders" class="@ahActive("Admin")"><span class="ah-nav-icon">📦</span> Sifarişlər</a></li>
                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Couriers" class="@ahActive("Admin")"><span class="ah-nav-icon">🛵</span> Kuryerlər</a></li>
                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Subscriptions" class="@ahActive("Admin")"><span class="ah-nav-icon">📖</span> Abunəliklər</a></li>
                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Rentals" class="@ahActive("Admin")"><span class="ah-nav-icon">📚</span> İcarələr</a></li>
                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Listings" class="@ahActive("Admin")"><span class="ah-nav-icon">🔁</span> C2C Bazar</a></li>

                <div class="ah-sidebar-divider"></div>

                <li><a asp-area="AdminPanel" asp-controller="Admin" asp-action="Admins" class="@ahActive("Admin")"><span class="ah-nav-icon">👤</span> Adminlər</a></li>
            </ul>
        </aside>

        <div class="ah-main">
            <div class="ah-topbar">
                <h1>@ViewData["Title"]</h1>
                <div class="ah-topbar-right">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="ah-topbar-user">👋 @User.Identity.Name</span>
                    }
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="ah-back-to-site">← Sayta qayıt</a>
                </div>
            </div>

            <div class="ah-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @RenderBody()
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
